{
  "name": "securee2e",
  "version": "0.5.0",
  "author": {
    "name": "Daniele Frisanco",
    "url": "https://www.linkedin.com/in/daniele-frisanco-9589835a/"
  },
  "description": "End-to-end encryption on the Web Crypto API: authenticated ECDH key exchange (ECDSA identity keys, HKDF, AES-256-GCM) with identity pinning. Framework-agnostic core plus a Vue 3 composable.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.mjs",
      "require": "./dist/vue.cjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "vue": ["./dist/vue.d.ts"]
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.6.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "fake-indexeddb": "^6.2.3",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "vue": "^3.5.22",
    "vue-tsc": "^3.1.0"
  },
  "keywords": [
    "e2e",
    "end-to-end-encryption",
    "webcrypto",
    "ecdh",
    "ecdsa",
    "hkdf",
    "aes-gcm",
    "diffie-hellman",
    "vue",
    "composable"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/danielefrisanco/securee2e.git"
  },
  "homepage": "https://github.com/danielefrisanco/securee2e#readme",
  "bugs": {
    "url": "https://github.com/danielefrisanco/securee2e/issues"
  }
}
